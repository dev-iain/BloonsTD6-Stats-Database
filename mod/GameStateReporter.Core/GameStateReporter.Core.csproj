<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Game-independent logic of the mod (contract DTOs, JSON, send policy). The mod project compiles
    these files into its own DLL, so this project exists only so the tests can build without BTD6.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>GameStateReporter</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
